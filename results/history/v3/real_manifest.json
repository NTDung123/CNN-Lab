  "annotation_policy": {
    "unit": "Outer physical silhouette. Coins, discs and bottle caps are circular target objects; cassettes, their cases, near-rectangular floppy disks/SD adapters are rectangles, including mildly chamfered corners. Perspective and occlusion are explicitly stress cases.",
    "exclude": "Internal slots, printed text, holes, labels, shadows and small texture regions are not separate target objects.",
    "coordinates": "xywh, half-open, in distributed image pixels. Images have maximum side 800.",
    "annotation_quality": "Manual outer-object boxes checked visually before predictions; no second annotator or pixel masks. Occluded boxes are estimates within the image; clipped boxes cover the visible extent. Physical circular objects can appear elliptical under perspective; report these as stress, not ideal 2D circles."
  },
  "protocol": {
    "real_images_used_for_training": false,
    "real_images_used_for_model_selection": false,
    "preprocessing_tuned_on_real_test": false,
    "split_unit": "Original source/capture family, conservatively grouping same-author series; no crop/resize can cross roles.",
    "test_policy": "Six previously evaluated photos are now development, not unseen test. New roles and manual labels frozen BEFORE predictions. Pipeline selected using development/validation only; final test accessed only after protocol freeze.",
    "statistical_scope": "Small convenience sample, manual single-annotator boxes; not a representative real-world benchmark.",
    "preprocessing_tuned_on_development_and_validation": true
  },
