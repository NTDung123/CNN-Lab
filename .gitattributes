# Frozen evaluation identities hash raw file bytes. Always check out these
# sources/manifests as LF, including on Windows with core.autocrlf=true.
* text=auto eol=lf
*.py text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.bat text eol=crlf
Dockerfile text eol=lf
*.npz binary
*.pt binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.docx binary
